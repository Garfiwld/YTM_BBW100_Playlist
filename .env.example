# Copy to .env and fill in. Loaded automatically by sync.py.
# On GitHub Actions these come from repo secrets instead.

YTM_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
YTM_CLIENT_SECRET=your-oauth-client-secret

# Optional: path to the OAuth token json (default: ./oauth.json)
#YTM_OAUTH_FILE=oauth.json
