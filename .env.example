# Copy to .env and fill in. Loaded automatically by sync.py; also used by
#   ytmusicapi oauth --client-id "$YTM_CLIENT_ID" --client-secret "$YTM_CLIENT_SECRET"
# On GitHub Actions these come from repo secrets instead, not this file.

YTM_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
YTM_CLIENT_SECRET=your-oauth-client-secret

# Optional: path to the OAuth token file (default: ./oauth.json)
#YTM_OAUTH_FILE=oauth.json
